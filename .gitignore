# Python
__pycache__/
*.py[cod]
# No trailing slash: a worktree's .venv is a SYMLINK to the main checkout's,
# and a directory-only pattern (".venv/") does not match a symlink, so every
# worktree showed a spurious untracked .venv. A bare name matches both.
.venv
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build artifacts
build/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local session state
.claude/
captures/

# harness/run_stack.py writes one directory per run: per-process logs plus
# each device's raw lateness samples.
runs/

# Agent/SDD scratch: reports, ledgers, review packages. Never project docs
# (those live in docs/superpowers/). The SDD skill assumes this is ignored.
.superpowers/

# Arco writes this into the cwd on every run of harness/terrarium_boot.py
o2debug.log
